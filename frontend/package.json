{
    "name": "rupiverse",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "dependencies": {
        "@expo-google-fonts/geist": "^0.4.2",
        "expo": "~58.0.23",
        "expo-constants": "~58.0.15",
        "expo-font": "~58.0.11",
        "expo-linking": "~58.0.16",
        "expo-router": "~58.0.30",
        "expo-secure-store": "~58.0.2",
        "expo-status-bar": "~58.0.4",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-svg": "15.16.0",
        "react-native-web": "^0.21.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/react-native": "^14.1.0",
        "@types/jest": "30.0.0",
        "@types/node": "^26.6.6",
        "@types/react": "~19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-expo": "~58.0.4",
        "husky": "^9.1.7",
        "jest": "~30.5.2",
        "jest-expo": "~58.0.14",
        "lint-staged": "^17.6.0",
        "typescript": "~6.0.3"
    },
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "lint:fix": "expo lint --fix",
        "prepare": "cd .. && husky frontend/.husky",
        "test": "EXPO_PUBLIC_API_MODE=mock jest",
        "gen:api": "npx --yes openapi-typescript@7 ${EXPO_PUBLIC_API_URL:-http://localhost:8000}/openapi.json -o src/types/api.gen.ts"
    },
    "private": true,
    "lint-staged": {
        "*.{js,jsx,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0 --no-warn-ignored"
    },
    "jest": {
        "preset": "jest-expo",
        "testMatch": [
            "<rootDir>/src/**/*.test.ts?(x)"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    }
}
