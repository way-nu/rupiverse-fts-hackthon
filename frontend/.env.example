# Copy to .env and fill in. Never commit .env.

# Base URL of the RupiVerse API (backend). Also read by `npm run gen:api` for the OpenAPI types.
EXPO_PUBLIC_API_URL=http://localhost:8000
# live (default) talks to the API; mock runs the whole app on in-app mocks with no backend (code 123456).
EXPO_PUBLIC_API_MODE=live
