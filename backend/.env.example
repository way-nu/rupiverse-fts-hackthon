# Copy to .env and fill in. Never commit .env. Env vars override values in this file.
# Staging: keep the same keys in .env.staging (Supabase staging values, never production) and run
#   uv run --env-file .env.staging alembic upgrade head

# Postgres (asyncpg). Local Postgres for dev + tests. Supabase (staging/prod): take the direct or session-pooler
# string (port 5432, never the 6543 transaction pooler), use the postgresql+asyncpg:// scheme and add ?ssl=require.
DATABASE_URL=postgresql+asyncpg://rupiverse@localhost:5432/rupiverse_dev
# Admin URL used by the acceptance tests to create throwaway databases.
TEST_DATABASE_URL=postgresql+asyncpg://rupiverse@localhost:5432/postgres

# Signing key for access JWTs (HS256). At least 32 characters, random; the app refuses to start without it.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# HMAC key for one-time email codes. At least 32 characters, different from JWT_SECRET.
CODE_HASH_SECRET=change-me-to-another-random-32-plus-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Gmail SMTP with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=your-app-password
SMTP_FROM=you@example.com

# Comma-separated browser origins allowed to call the API (Expo web).
CORS_ORIGINS=http://localhost:8081
# development | test | production
APP_ENV=development
# TEST ONLY: replaces SMTP with an in-memory outbox at GET /test/outbox/latest. Never true in production.
TEST_OUTBOX_ENABLED=false
