# Copy to .env and fill in. Never commit .env. Env vars override values in this file.

# Postgres (asyncpg). Local Docker/Homebrew for dev + tests; Supabase direct connection (port 5432) in production.
DATABASE_URL=postgresql+asyncpg://rupiverse@localhost:5432/rupiverse_dev
# Admin URL used by the acceptance tests to create throwaway databases.
TEST_DATABASE_URL=postgresql+asyncpg://rupiverse@localhost:5432/postgres

# Signing key for access JWTs (HS256). Long random string.
JWT_SECRET=change-me-to-a-long-random-string
# HMAC key for one-time email codes. Long random string, different from JWT_SECRET.
CODE_HASH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Gmail SMTP with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=your-app-password
SMTP_FROM=you@example.com

# Comma-separated browser origins allowed to call the API (Expo web).
CORS_ORIGINS=http://localhost:8081
# development | test | production
APP_ENV=development
# TEST ONLY: replaces SMTP with an in-memory outbox at GET /test/outbox/latest. Never true in production.
TEST_OUTBOX_ENABLED=false
